# Docker bridge gateway - reachable from the JasmineGraph master/worker containers
# (the LAN IP 10.10.11.43 times out from inside their network)
HOST=http://172.17.0.1
PORT=8080

# Postgres connection
POSTGRES_URL=postgresql://admin:admin_password@postgres:5432/jasminegraphdb

DEV_MODE=false

# Default Kafka broker, used when the master's prp response does not include one.
# This is the cluster Kafka's advertised address on the jasminegraph-net docker network.
KAFKA_BROKER=172.28.5.8:9092
